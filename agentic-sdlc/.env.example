# Copy to .env. Only needed for --mode live; replay/mock need nothing.
AGENTIC_LLM_MODE=replay
AGENTIC_LLM_MODEL=claude-sonnet-5
AGENTIC_ANTHROPIC_API_KEY=

AGENTIC_MAX_CONCURRENT_NODES=4
AGENTIC_MAX_RUN_WALL_CLOCK_SECONDS=3600
AGENTIC_MAX_RUN_TOKENS=2000000
AGENTIC_MAX_RUN_COST_USD=25.0
AGENTIC_REPLAN_BUDGET=3

AGENTIC_COVERAGE_FLOOR=0.80
AGENTIC_CHANGE_BUDGET_FILES=10
AGENTIC_AMBIGUITY_SCORE_THRESHOLD=0.5
